<phpunit backupGlobals="true"
         backupStaticAttributes="false"
         bootstrap="test/bootstrap.php"
         colors="true"
         convertDeprecationsToExceptions="true">
    <!--
        convertDeprecationsToExceptions: PHPUnit 9 only reports deprecations by
        default, and a report nobody reads is how the ArrayAccess signatures sat
        deprecated for three PHP releases. A deprecation fails the suite instead.
    -->
    <testsuites>
        <testsuite name="Idiorm Test Suite">
            <directory suffix="Test.php">test</directory>
            <directory suffix="Test53.php">test</directory>
        </testsuite>
    </testsuites>
</phpunit>
